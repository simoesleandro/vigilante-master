# Bot do Telegram
TOKEN_TELEGRAM=

# ID do administrador (chat_id numérico — comandos mutativos só este chat)
ADMIN_ID=

# IDs de destinatários (espectadores — só leitura + IA), separados por vírgula
CHATS_ESPECTADORES=

# Google Gemini (resumos evolutivos)
API_KEY_GEMINI=

# Espaço mínimo em disco (GB) — aborta ciclos se abaixo disso
DISCO_MIN_GB=2

# Porta do painel web Flask (default 8080)
FLASK_PORT=8080
